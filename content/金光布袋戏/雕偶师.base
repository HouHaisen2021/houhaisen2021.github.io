summaries:
  new summary: ""
views:
  - type: table
    name: 表格
    filters:
      and:
        - file.folder == "角色库"
    order:
      - file.name
      - 雕偶师
    sort: []
    summaries:
      武器类型: new summary
    columnSize:
      note.雕偶师: 291
      note.武器: 154
      note.武器类型: 117
  - type: table
    name: 陈文龙
    filters:
      and:
        - file.folder == "角色库"
        - 雕偶师.containsAny("陈文龙")
    order:
      - file.name
      - 雕偶师
    columnSize:
      file.name: 91
